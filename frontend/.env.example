# The web door reads these at build time on Vercel (project axismeru/pravrudhi-app) and in a local `npm run dev`.
# Both are public by design: the anon/publishable key is meant for browsers. Never a service key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# The engine the web door talks to. Unset means the page shows the connection banner and nothing pretends to run.
NEXT_PUBLIC_API_BASE=
