  "scenes": [
    {
      "name": "Benchmark",
      "text": "NyayaSiddhi",
      "startS": 0,
      "endS": 23.5
    },
    {
      "name": "What it is",
      "text": "Facts and a named offence in. PROOF or NOT_PROOF out.",
      "startS": 23.5,
      "endS": 52.7
    },
    {
      "name": "The released sets",
      "text": "Two sets, both public.",
      "startS": 52.7,
      "endS": 83.80000000000001
    },
    {
      "name": "Why it was needed",
      "text": "This is a statement about our search.",
      "startS": 83.80000000000001,
      "endS": 106.4
    },
    {
      "name": "Works we looked at",
      "text": "Names only, from their abstracts and card pages.",
      "startS": 106.4,
      "endS": 163.9
    },
    {
      "name": "The two numbers",
      "text": "Always together. Never one alone.",
      "startS": 163.9,
      "endS": 189.9
    },
    {
      "name": "Taking part: before you submit",
      "text": "A prediction file, a manifest, and a check on your own machine.",
      "startS": 189.9,
      "endS": 234.3
    },
    {
      "name": "Taking part: submitting",
      "text": "A Hugging Face pull request, with consent.",
      "startS": 234.3,
      "endS": 280.1
    },
    {
      "name": "The leaderboard",
      "text": "Rows are listed in a fixed order, by split and system name, never by a figure.",
      "startS": 280.1,
      "endS": 309.70000000000005
    },
    {
      "name": "How it is scored",
      "text": "One open scorer. The same steps for every submission.",
      "startS": 309.70000000000005,
      "endS": 365.00000000000006
    },
    {
      "name": "Our own rows",
      "text": "We built this benchmark and we enter our own systems in it.",
      "startS": 365.00000000000006,
      "endS": 411.50000000000006
    },
    {
      "name": "What does not exist yet",
      "text": "No hidden split. No hosted evaluation.",
      "startS": 411.50000000000006,
      "endS": 438.70000000000005
    },
    {
      "name": "NyayaSiddhi",
      "text": "A place to compare.",
      "startS": 438.70000000000005,
      "endS": 452.6
    }
  ],
