  "scenes": [
    {
      "name": "Pravrudhi-Nyaya",
      "text": "The name and its purpose land on a case-file sheet.",
      "startS": 0,
      "endS": 16
    },
    {
      "name": "Scope and names",
      "text": "Indian law, starting with criminal matters; Pravrudhi-Nyaya is the product, Prabhāsa-Nyāya our own trained models.",
      "startS": 16,
      "endS": 30.1
    },
    {
      "name": "The problem",
      "text": "Fluent AI answers versus a matter that needs every ingredient shown.",
      "startS": 30.1,
      "endS": 45.900000000000006
    },
    {
      "name": "Your facts",
      "text": "The live Matter workspace: the complaint split into numbered facts, the offence ticked.",
      "startS": 45.900000000000006,
      "endS": 57.50000000000001
    },
    {
      "name": "Each ingredient",
      "text": "The live checklist: every ingredient with its status and what to check.",
      "startS": 57.50000000000001,
      "endS": 71.80000000000001
    },
    {
      "name": "A review agenda",
      "text": "The live result on a public order: what is missing for each ingredient and what to check; ends on the standing line.",
      "startS": 71.80000000000001,
      "endS": 106.70000000000002
    },
    {
      "name": "Matter tools",
      "text": "Matter tools: add the papers of a matter; kept as text in the EU (Romania) until you delete.",
      "startS": 106.70000000000002,
      "endS": 130.4
    },
    {
      "name": "A sample matter",
      "text": "One click loads an invented sample matter.",
      "startS": 130.4,
      "endS": 144.9
    },
    {
      "name": "Two models",
      "text": "Our trained models read each ingredient; both must agree or the matter is referred.",
      "startS": 144.9,
      "endS": 162.8
    },
    {
      "name": "Real field data",
      "text": "Built from real judgments and orders: gathered, cleaned, read by two models and checked, then divided into training, held-out testing and evaluation sets. Evaluation items are checked against training data. Real and constructed cases are labelled.",
      "startS": 162.8,
      "endS": 183.4
    },
    {
      "name": "The formal check",
      "text": "Each offence is a formal contract; the check confirms every ingredient was addressed.",
      "startS": 183.4,
      "endS": 199.9
    },
    {
      "name": "Nyaya discipline",
      "text": "Three Nyaya ideas that change a result: evidence you can point to, judgment withheld, testimony is checked, not trusted.",
      "startS": 199.9,
      "endS": 220.8
    },
    {
      "name": "The pipeline",
      "text": "The seven stages light up in order, from ingest to decide.",
      "startS": 220.8,
      "endS": 238.3
    },
    {
      "name": "Managed workflows",
      "text": "Optional managed workflows broaden the same core: the assistant proposes, the core decides.",
      "startS": 238.3,
      "endS": 253.5
    },
    {
      "name": "The tools, part 1",
      "text": "The tools that use the papers, part 1.",
      "startS": 253.5,
      "endS": 282.5
    },
    {
      "name": "The tools, part 2",
      "text": "The tools that use the papers, part 2.",
      "startS": 282.5,
      "endS": 309.5
    },
    {
      "name": "First drafts",
      "text": "Bail grounds and the synopsis with a list of dates: first drafts for a lawyer to rewrite.",
      "startS": 309.5,
      "endS": 344
    },
    {
      "name": "The citation check",
      "text": "The citation check: existence only.",
      "startS": 344,
      "endS": 354.4
    },
    {
      "name": "What sets it apart",
      "text": "Four differences from general-purpose legal AI.",
      "startS": 354.4,
      "endS": 375.79999999999995
    },
    {
      "name": "Privacy and cost",
      "text": "Our own models on rented GPUs; the live data-handling page.",
      "startS": 375.79999999999995,
      "endS": 393.59999999999997
    },
    {
      "name": "End card",
      "text": "Name, line and address.",
      "startS": 393.59999999999997,
      "endS": 400.09999999999997
    }
  ],
